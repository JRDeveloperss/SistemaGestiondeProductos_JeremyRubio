@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">
        Sistema de Gestión de Productos
    </h1>

    <p class="lead text-muted mt-3">
        Administra tus productos de forma rápida y sencilla.
    </p>

    <div class="d-flex justify-content-center gap-3 mt-4">
        <a asp-controller="Productos"
           asp-action="Create"
           class="btn btn-primary btn-lg">
            Crear producto
        </a>

        <a asp-controller="Productos"
           asp-action="ListaProductosIndex"
           class="btn btn-outline-secondary btn-lg">
            Ver productos
        </a>
    </div>
</div>

<div class="row g-4 mt-3">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h4 class="card-title">Crear</h4>
                <p class="card-text text-muted">
                    Registra nuevos productos con su precio, cantidad y descripción.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h4 class="card-title">Consultar</h4>
                <p class="card-text text-muted">
                    Visualiza todos los productos almacenados en el sistema.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h4 class="card-title">Editar</h4>
                <p class="card-text text-muted">
                    Actualiza la información de cualquier producto registrado.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h4 class="card-title">Eliminar</h4>
                <p class="card-text text-muted">
                    Elimina productos que ya no necesites conservar.
                </p>
            </div>
        </div>
    </div>
</div>